# ==========================================
# Telegram Bot Configuration
# ==========================================

# Your Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (Numeric) for Admin access
ADMIN_ID=123456789

# Premium / VIP Telegram Channel ID (Negative integer, e.g. -100xxxxxxxxxx)
CHANNEL_ID=-1001234567890

# Free / Public Telegram Channel ID for promotions and marketing broadcasts
FREE_CHANNEL_ID=-1001234567890

# ==========================================
# Payment Configuration
# ==========================================

# Your UPI Virtual Payment Address (VPA) for receiving payments
UPI_ID=yourname@upi

# Subscription plan price in INR (e.g. 299)
PLAN_PRICE=299

# Subscription validity duration in days (e.g. 30)
PLAN_DURATION_DAYS=30
